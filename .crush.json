{
  "$schema": "https://charm.land/crush.json",
  "options": {
    "initialize_as": "AGENTS.md"
  },
  "lsp": {
    "go": {
      "command": "$HOME/.local/share/nvim/mason/packages/gopls/gopls",
      "args": ["serve"]
    }
  },
  "mcp": {
    "exa": {
      "type": "stdio",
      "command": "bunx",
      "args": ["-y", "exa-mcp-server"],
      "timeout": 300,
      "disabled": false,
      "headers": {
        "Authorization": "Bearer $EXA_API_KEY"
      }
    },
    "jina": {
      "type": "sse",
      "url": "https://mcp.jina.ai/sse",
      "command": "bunx",
      "args": [
        "mcp-remote",
        "https://mcp.jina.ai/sse",
        "--header",
        "Authorization Bearer $JINA_API_KEY"
      ],
      "timeout": 300,
      "disabled": false
    }
  }
}
