package main

import (
	"context"
	"fmt"
	"log"
	"os"
	"path/filepath"
	"strings"
	"time"

	"github.com/assagman/dsgo"
)

// Constants for field names and packages to avoid hardcoding strings
const (
	// Package targets
	PkgRetry    = "internal/retry"
	PkgJsonUtil = "internal/jsonutil"
	PkgTyped    = "internal/typed"

	// Input/Output Fields
	FieldPkgName     = "package_name"
	FieldCodeContent = "code_content"
	FieldAnalysis    = "analysis"
	FieldKeyFindings = "key_findings"
	FieldCombined    = "combined_analyses"
	FieldExecSummary = "executive_summary"
	FieldArchDiagram = "architecture_diagram"
	FieldImprovement = "improvement_suggestions"

	// Model
	ModelName = "openrouter/deepseek/deepseek-v3.2"
)

func main() {
	ctx := context.Background()

	// Initialize LM
	lm, err := dsgo.NewLM(ctx, ModelName)
	if err != nil {
		log.Fatalf("Failed to create LM: %v", err)
	}

	// Find project root
	projectRoot, err := findProjectRoot()
	if err != nil {
		log.Fatalf("Failed to find project root: %v", err)
	}

	// Target packages to analyze
	packages := []string{PkgRetry, PkgJsonUtil, PkgTyped}

	fmt.Println("🚀 Starting Parallel Code Analysis...")

	// Stage 1: Read package contents
	fmt.Println("\n📂 Reading package contents...")
	var inputs []map[string]any

	for _, pkg := range packages {
		fullPath := filepath.Join(projectRoot, pkg)
		content, err := readPackageContent(fullPath)
		if err != nil {
			log.Printf("Warning: failed to read package %s: %v", pkg, err)
			continue
		}
		inputs = append(inputs, map[string]any{
			FieldPkgName:     pkg,
			FieldCodeContent: content,
		})
		fmt.Printf("  - Loaded %s (%d bytes)\n", pkg, len(content))
	}

	// Stage 2: Parallel Analysis (Demonstrating 3 different Parallel strategies)
	fmt.Println("\n🧠 Stage 1: Analyzing packages in parallel (using 3 different Parallel strategies)...")

	// Define signature for single package analysis
	analysisSig := dsgo.NewSignature("Analyze Go package").
		AddInput(FieldPkgName, dsgo.FieldTypeString, "Name of the package").
		AddInput(FieldCodeContent, dsgo.FieldTypeString, "Content of all Go files in the package").
		AddOutput(FieldAnalysis, dsgo.FieldTypeString, "Detailed analysis of the package's purpose and design").
		AddOutput(FieldKeyFindings, dsgo.FieldTypeString, "List of key architectural findings or patterns")

	// Channels to collect results
	resultsChan := make(chan analysisResult, len(packages))

	// 1. Analyze 'internal/retry' using NewParallel (Shared Instance)
	// Good for stateless modules.
	go func() {
		analyzer := dsgo.NewChainOfThought(analysisSig, lm)
		parallelMod := dsgo.NewParallel(analyzer)
		runWorker(ctx, 1, PkgRetry, "NewParallel", parallelMod, inputs, resultsChan)
	}()

	// 2. Analyze 'internal/jsonutil' using NewParallelWithInstances (Pre-created Instances)
	// Good when you have a fixed set of initialized modules (e.g. with different configs)
	go func() {
		// Create 2 instances just to show we can (though we only process 1 item here)
		instances := []dsgo.Module{
			dsgo.NewChainOfThought(analysisSig, lm),
			dsgo.NewChainOfThought(analysisSig, lm),
		}
		parallelMod := dsgo.NewParallelWithInstances(instances)
		runWorker(ctx, 2, PkgJsonUtil, "NewParallelWithInstances", parallelMod, inputs, resultsChan)
	}()

	// 3. Analyze 'internal/typed' using NewParallelWithFactory (Dynamic Factory)
	// Best for stateful modules where each worker needs a fresh instance
	// We also demonstrate the 'Program' module here to chain analysis and refinement steps.
	go func() {
		factory := func(i int) dsgo.Module {
			// Define a refinement signature
			refineSig := dsgo.NewSignature("Refine analysis").
				AddInput(FieldAnalysis, dsgo.FieldTypeString, "Original analysis").
				AddInput(FieldKeyFindings, dsgo.FieldTypeString, "Original findings").
				AddOutput(FieldAnalysis, dsgo.FieldTypeString, "Refined and polished analysis").
				AddOutput(FieldKeyFindings, dsgo.FieldTypeString, "Refined key findings")

			// Create a Program pipeline: Analysis -> Refinement
			prog := dsgo.NewProgram("AnalysisPipeline").
				AddModule(dsgo.NewChainOfThought(analysisSig, lm)). // Step 1: Analyze
				AddModule(dsgo.NewRefine(refineSig, lm))            // Step 2: Refine

			return prog
		}
		parallelMod := dsgo.NewParallelWithFactory(factory)
		runWorker(ctx, 3, PkgTyped, "NewParallelWithFactory + Program", parallelMod, inputs, resultsChan)
	}()

	// Collect results
	var combinedAnalyses strings.Builder
	for range packages {
		res := <-resultsChan
		if res.err != nil {
			log.Printf("Error analyzing %s: %v", res.pkgName, res.err)
			continue
		}
		combinedAnalyses.WriteString(fmt.Sprintf("=== Package: %s ===\n", res.pkgName))
		combinedAnalyses.WriteString(fmt.Sprintf("Analysis:\n%s\n", res.analysis))
		combinedAnalyses.WriteString(fmt.Sprintf("Key Findings:\n%s\n\n", res.findings))
		fmt.Printf("  ✅ Finished %s\n", res.pkgName)
	}

	// Stage 3: Synthesis with BestOfN
	fmt.Println("\n🔗 Stage 2: Synthesizing results with BestOfN (ChainOfThought)...")

	synthesisSig := dsgo.NewSignature("Synthesize architecture report").
		AddInput(FieldCombined, dsgo.FieldTypeString, "Analyses of individual packages").
		AddOutput(FieldExecSummary, dsgo.FieldTypeString, "High-level summary of the subsystem").
		AddOutput(FieldArchDiagram, dsgo.FieldTypeString, "Text description of how these packages relate").
		AddOutput(FieldImprovement, dsgo.FieldTypeString, "Suggestions for improvement")

	// Create base module
	baseSynthesizer := dsgo.NewChainOfThought(synthesisSig, lm)

	// Create BestOfN module
	// We generate 3 candidates and pick the best one based on our scorer
	scorer := func(inputs map[string]any, prediction *dsgo.Prediction) (float64, error) {
		score := 0.0

		// Check for presence of key fields
		if val, ok := prediction.GetString(FieldExecSummary); ok && len(val) > 50 {
			score += 1.0
		}
		if val, ok := prediction.GetString(FieldArchDiagram); ok && len(val) > 50 {
			score += 1.0
		}

		// Give more weight to detailed improvement suggestions
		if val, ok := prediction.GetString(FieldImprovement); ok {
			// Score based on length (longer is usually more detailed)
			score += float64(len(val)) / 100.0
		}

		return score, nil
	}

	bestOfN := dsgo.NewBestOfN(baseSynthesizer, 3).
		WithScorer(scorer).
		WithParallel(true) // Run 3 attempts in parallel

	synthesisCtx, cancelSyn := context.WithTimeout(ctx, 2*time.Minute)
	defer cancelSyn()

	fmt.Println("  - Generating 3 candidate reports in parallel...")
	finalResult, err := bestOfN.Forward(synthesisCtx, map[string]any{
		FieldCombined: combinedAnalyses.String(),
	})
	if err != nil {
		log.Fatalf("Synthesis failed: %v", err)
	}

	fmt.Printf("  ✅ Best candidate selected with score: %.2f\n", finalResult.Score)

	// Output results
	fmt.Println("\n📊 FINAL ARCHITECTURE REPORT")
	fmt.Println("===========================")
	fmt.Printf("\n📝 Executive Summary:\n%s\n", getStringOrZero(finalResult, FieldExecSummary))
	fmt.Printf("\n🏗️  Architecture Overview:\n%s\n", getStringOrZero(finalResult, FieldArchDiagram))
	fmt.Printf("\n💡 Improvement Suggestions:\n%s\n", getStringOrZero(finalResult, FieldImprovement))

	// Save report
	saveReport(combinedAnalyses.String(), finalResult)
}

// Helper functions

func runWorker(ctx context.Context, id int, pkgName, strategy string, mod dsgo.Module, inputs []map[string]any, resultsChan chan<- analysisResult) {
	fmt.Printf("  [Worker %d] Starting analysis of %s using %s...\n", id, pkgName, strategy)
	input := getPackageInput(inputs, pkgName)
	res, err := mod.Forward(ctx, map[string]any{"_batch": []map[string]any{input}})
	resultsChan <- parseResult(pkgName, res, err)
}

func getPackageInput(inputs []map[string]any, name string) map[string]any {
	for _, in := range inputs {
		if in[FieldPkgName] == name {
			return in
		}
	}
	return nil
}

type analysisResult struct {
	pkgName  string
	analysis string
	findings string
	err      error
}

func parseResult(pkgName string, res *dsgo.Prediction, err error) analysisResult {
	if err != nil {
		return analysisResult{pkgName: pkgName, err: err}
	}
	// Parallel with single item returns result in main outputs (usually) or completions[0]
	// But since we use WithReturnAll=true (default) and process 1 item:
	analysis := getStringOrZero(res, FieldAnalysis)
	findings := getStringOrZero(res, FieldKeyFindings)

	if len(res.Completions) > 0 {
		if val, ok := res.Completions[0][FieldAnalysis].(string); ok {
			analysis = val
		}
		if val, ok := res.Completions[0][FieldKeyFindings].(string); ok {
			findings = val
		}
	}
	return analysisResult{
		pkgName:  pkgName,
		analysis: analysis,
		findings: findings,
	}
}

func readPackageContent(dir string) (string, error) {
	var content strings.Builder
	err := filepath.Walk(dir, func(path string, info os.FileInfo, err error) error {
		if err != nil {
			return err
		}
		if !info.IsDir() && strings.HasSuffix(path, ".go") && !strings.HasSuffix(path, "_test.go") {
			data, err := os.ReadFile(path)
			if err != nil {
				return err
			}
			content.WriteString(fmt.Sprintf("\n--- File: %s ---\n", filepath.Base(path)))
			content.WriteString(string(data))
		}
		return nil
	})
	return content.String(), err
}

func getStringOrZero(prediction *dsgo.Prediction, key string) string {
	if val, ok := prediction.GetString(key); ok {
		return val
	}
	return ""
}

func findProjectRoot() (string, error) {
	dir, err := os.Getwd()
	if err != nil {
		return "", err
	}
	for {
		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
			return dir, nil
		}
		parent := filepath.Dir(dir)
		if parent == dir {
			return "", fmt.Errorf("go.mod not found")
		}
		dir = parent
	}
}

func saveReport(rawAnalyses string, finalResult *dsgo.Prediction) {
	filename := fmt.Sprintf("architecture_report_%s.txt", time.Now().Format("2006-01-02_15-04-05"))
	file, err := os.Create(filename)
	if err != nil {
		log.Printf("Failed to create report file: %v", err)
		return
	}
	defer func() {
		if closeErr := file.Close(); closeErr != nil {
			log.Printf("Failed to close report file: %v", closeErr)
		}
	}()

	if _, err := fmt.Fprintf(file, "ARCHITECTURE REPORT\n===================\n\n"); err != nil {
		log.Printf("Failed to write to report file: %v", err)
		return
	}
	if _, err := fmt.Fprintf(file, "Executive Summary:\n%s\n\n", getStringOrZero(finalResult, FieldExecSummary)); err != nil {
		log.Printf("Failed to write to report file: %v", err)
		return
	}
	if _, err := fmt.Fprintf(file, "Architecture Overview:\n%s\n\n", getStringOrZero(finalResult, FieldArchDiagram)); err != nil {
		log.Printf("Failed to write to report file: %v", err)
		return
	}
	if _, err := fmt.Fprintf(file, "Suggestions:\n%s\n\n", getStringOrZero(finalResult, FieldImprovement)); err != nil {
		log.Printf("Failed to write to report file: %v", err)
		return
	}
	if _, err := fmt.Fprintf(file, "===================\nRAW PACKAGE ANALYSES\n===================\n%s", rawAnalyses); err != nil {
		log.Printf("Failed to write to report file: %v", err)
		return
	}

	fmt.Printf("\n💾 Full report saved to: %s\n", filename)
}

